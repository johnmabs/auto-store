generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
}

enum VehicleLocationStatus {
  ABROAD
  IN_TRANSIT
  IN_CONGO
}

enum CongoCity {
  POINTE_NOIRE
  BRAZZAVILLE
}

enum Currency {
  XAF
  USD
  EUR
}

enum PriceBasis {
  VEHICLE_ONLY
  LANDED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  OTHER
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
  CVT
  DCT
  OTHER
}

enum VehicleBodyType {
  SUV
  SEDAN
  HATCHBACK
  COUPE
  PICKUP
  MINIVAN
  WAGON
  CONVERTIBLE
  OTHER
}

enum VehicleOrigin {
  JAPAN
  CHINA
  UNITED_ARAB_EMIRATES
  GERMANY
  FRANCE
  SOUTH_KOREA
  UNITED_STATES
}

enum CustomerRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

model Vehicle {
  id   String @id @default(cuid())
  slug String @unique

  make     String
  model    String
  variant  String?
  year     Int
  mileage  Int
  bodyType VehicleBodyType

  fuelType     FuelType
  transmission TransmissionType

  engine String?
  power  Int?

  color         String?
  interiorColor String?
  doors         Int?
  seats         Int?

  originCountry VehicleOrigin

  locationStatus VehicleLocationStatus
  congoCity      CongoCity?

  price           Int
  currency        Currency
  priceBasis      PriceBasis
  priceNegotiable Boolean    @default(false)

  status      VehicleStatus @default(DRAFT)
  description String?       @db.Text
  featured    Boolean       @default(false)

  features String[]

  images   VehicleImage[]
  requests CustomerRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([locationStatus])
  @@index([make, model])
  @@index([year])
  @@index([price])
}

model VehicleImage {
  id String @id @default(cuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url      String
  publicId String

  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  width  Int?
  height Int?

  createdAt DateTime @default(now())

  @@index([vehicleId, position])
}

model CustomerRequest {
  id String @id @default(cuid())

  firstName String
  lastName  String?
  phone     String
  email     String?

  message String? @db.Text

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  status CustomerRequestStatus @default(NEW)

  adminNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([vehicleId])
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
}
